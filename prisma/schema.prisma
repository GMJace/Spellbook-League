generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  DM
  EVENT_ADMIN
  LEAGUE_ADMIN
  PATRON
}

enum GameStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ParticipantLogStatus {
  PENDING
  APPROVED
}

enum Tier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

enum NotificationType {
  ADMIN
  SYSTEM
  GAME_CREATED
  GAME_UPDATED
  GAME_DELETED
  GAME_LOGGED
  PRO_DM_ROSTER
}

enum GrimoireDmSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SiteMonitorLevel {
  INFO
  WARN
  ERROR
}

enum SiteMonitorCategory {
  HEALTH_CHECK
  APPLICATION_ERROR
  SYSTEM_EVENT
}

enum SiteHealthStatus {
  HEALTHY
  DEGRADED
  FAILING
}

enum CheckoutType {
  LEAGUE
  GRIMOIRE
}

enum CheckoutStatus {
  CREATED
  COMPLETED
  FAILED
}

enum TicketSaleSourceType {
  LEAGUE_GAME
  GRIMOIRE_BADGE
  GRIMOIRE_GAME
  MEMBERSHIP
  OTHER
}

enum DmPaymentMethodType {
  PAYPAL
  E_TRANSFER
  BANK_TRANSFER
  CASH
  OTHER
}

enum TicketPayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum CharacterTradeStatus {
  PENDING
  CONFIRMED
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  discordHandle String?
  profileImagePath String?
  passwordHash String?
  newGameSignupAlertsEnabled Boolean @default(false)
  storeCreditUsd Float           @default(0)
  storeCreditHeldUsd Float       @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  roles        UserRole[]
  characters   Character[]
  gamesCreated Game[]            @relation("GameDungeonMaster")
  gamesLogged  Game[]            @relation("GameLoggedBy")
  participants GameParticipant[]
  awardedAchievements CharacterAchievement[] @relation("AchievementAwardedBy")
  accounts     Account[]
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]   @relation("UserNotifications")
  createdNotifications Notification[] @relation("NotificationCreatedBy")
  siteHealthChecksTriggered SiteHealthCheck[]
  checkoutOrders CheckoutOrder[]
  patronMemberships PatronMembership[]
  ticketSalesSettingsUpdated TicketSalesSettings[] @relation("TicketSalesSettingsUpdatedBy")
  ticketRefundsCreated TicketRefund[] @relation("TicketRefundCreatedBy")
  spellbookExpenseReceiptsCreated SpellbookExpenseReceipt[] @relation("SpellbookExpenseReceiptCreatedBy")
  dmPaymentProfiles DmPaymentProfile[] @relation("DmPaymentProfileUser")
  ticketPayoutsAsDm TicketPayout[] @relation("TicketPayoutDmUser")
  ticketPayoutsCreated TicketPayout[] @relation("TicketPayoutCreatedBy")
  reportedPendingAdventureModules PendingAdventureModule[] @relation("PendingAdventureModuleReportedBy")
  characterTradesProposed CharacterTrade[] @relation("CharacterTradeProposedByUser")
  characterTradesReceived CharacterTrade[] @relation("CharacterTradeReceivedByUser")
  characterTradesConfirmed CharacterTrade[] @relation("CharacterTradeConfirmedByUser")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Character {
  id           String            @id @default(cuid())
  userId       String
  name         String
  isPubliclyViewable Boolean     @default(true)
  characterSheetLink String?
  hitPoints    Int?
  armorClass   Int?
  passivePerception Int?
  spellSaveDc  Int?
  tokenImagePath String?
  class1Name   String
  class1Subclass String?
  class1Level  Int
  class2Name   String?
  class2Subclass String?
  class2Level  Int?
  class3Name   String?
  class3Subclass String?
  class3Level  Int?
  feats        String            @default("")
  proficiencies String           @default("")
  tools        String            @default("")
  languages    String            @default("")
  notes        String            @default("")
  backstory    String            @default("")
  totalGold    Int               @default(0)
  magicItems   String            @default("[]")
  magicItemMinorProperties String @default("[]")
  magicItemFlavors String        @default("[]")
  commonMagicItems String        @default("[]")
  commonMagicItemMinorProperties String @default("[]")
  commonMagicItemFlavors String  @default("[]")
  consumables  String            @default("[]")
  boon         String            @default("")
  blessing     String            @default("")
  charms       String            @default("[]")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants GameParticipant[]
  achievementAwards CharacterAchievement[]
  tradesProposed CharacterTrade[] @relation("CharacterTradeProposerCharacter")
  tradesReceived CharacterTrade[] @relation("CharacterTradeRecipientCharacter")
}

model Achievement {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  category      String
  name          String
  description   String
  badgeImagePath String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  awards        CharacterAchievement[]
}

model CharacterAchievement {
  id              String      @id @default(cuid())
  achievementId   String
  characterId     String
  awardedByUserId String
  awardedAt       DateTime    @default(now())
  gameCode        String?
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  character       Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  awardedBy       User        @relation("AchievementAwardedBy", fields: [awardedByUserId], references: [id], onDelete: Cascade)

  @@index([achievementId])
  @@index([characterId, awardedAt])
  @@index([awardedByUserId, awardedAt])
}

model CharacterTrade {
  id                          String               @id @default(cuid())
  proposerUserId              String
  proposerCharacterId         String
  recipientUserId             String
  recipientCharacterId        String
  proposerItem                String
  proposerItemName            String               @default("")
  proposerMinorProperty       String               @default("")
  proposerFlavorNotes         String               @default("")
  proposerAdventureCode       String               @default("")
  proposerDowntimeDaysSpent   Int                  @default(0)
  recipientItem               String
  recipientItemName           String               @default("")
  recipientMinorProperty      String               @default("")
  recipientFlavorNotes        String               @default("")
  recipientAdventureCode      String               @default("")
  recipientDowntimeDaysSpent  Int                  @default(0)
  status                      CharacterTradeStatus @default(PENDING)
  confirmedByUserId           String?
  confirmedAt                 DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  proposerUser                User                 @relation("CharacterTradeProposedByUser", fields: [proposerUserId], references: [id], onDelete: Cascade)
  proposerCharacter           Character            @relation("CharacterTradeProposerCharacter", fields: [proposerCharacterId], references: [id], onDelete: Cascade)
  recipientUser               User                 @relation("CharacterTradeReceivedByUser", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientCharacter          Character            @relation("CharacterTradeRecipientCharacter", fields: [recipientCharacterId], references: [id], onDelete: Cascade)
  confirmedByUser             User?                @relation("CharacterTradeConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([proposerCharacterId, createdAt(sort: Desc)])
  @@index([recipientCharacterId, createdAt(sort: Desc)])
  @@index([recipientUserId, status, createdAt(sort: Desc)])
  @@index([proposerUserId, status, createdAt(sort: Desc)])
}

model Game {
  id                  String            @id @default(cuid())
  dmId                String?
  loggedByUserId      String?
  dmName              String?
  title               String
  adventureCode       String
  source              String            @default("")
  gameSummary         String            @default("")
  ticketPrice         String            @default("Free")
  ticketAccessCodeHash String?
  adventureImagePath  String?
  datePlayed          DateTime
  duration            String            @default("")
  tier                Tier
  seatCapacity        Int               @default(6)
  serviceHours        Float             @default(0)
  downtimeDaysAwarded Int               @default(0)
  rewardsSummary      String
  magicItemsAwarded   String            @default("")
  consumablesAwarded  String            @default("")
  spellbookAwarded    String            @default("")
  consequencesSummary String
  sessionNotes        String
  status              GameStatus
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  dm                  User?             @relation("GameDungeonMaster", fields: [dmId], references: [id], onDelete: Cascade)
  loggedByUser        User?             @relation("GameLoggedBy", fields: [loggedByUserId], references: [id], onDelete: SetNull)
  participants        GameParticipant[]
}

model GameParticipant {
  id                    String               @id @default(cuid())
  gameId                String
  characterId           String?
  userId                String
  logStatus             ParticipantLogStatus @default(APPROVED)
  approvedAt            DateTime?
  logRewardsSummary     String?
  logMagicItemsAwarded  String?
  logConsumablesAwarded String?
  logSpellbookAwarded   String?
  logSessionNotes       String?
  createdAt             DateTime             @default(now())
  game                  Game                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character             Character?           @relation(fields: [characterId], references: [id], onDelete: SetNull)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, characterId])
}

model AdventureCatalog {
  id                    String   @id @default(cuid())
  adventureCode         String
  lookupCode            String
  title                 String
  lookupTitle           String
  tier                  Tier
  duration              String   @default("")
  gameSummary           String   @default("")
  adventureImagePath    String?
  serviceHours          Float    @default(0)
  downtimeDaysAwarded   Int      @default(0)
  gold                  String   @default("")
  spellbook             String   @default("")
  storyAwards           String   @default("")
  pageNumbers           String   @default("")
  sourceSheet           String   @default("")
  sourceNotes           String   @default("")
  consumablesJson       String   @default("[]")
  commonMagicItemsJson  String   @default("[]")
  uncommonMagicItemsJson String  @default("[]")
  rareMagicItemsJson    String   @default("[]")
  veryRareMagicItemsJson String  @default("[]")
  legendaryMagicItemsJson String @default("[]")
  uniqueMagicItemsJson  String   @default("[]")
  boonsJson             String   @default("[]")
  blessingsJson         String   @default("[]")
  charmsJson            String   @default("[]")
  additionalMagicRewardNotes String @default("")
  additionalConsumableNotes String @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([lookupCode, lookupTitle, tier])
  @@index([lookupCode, tier])
  @@index([adventureCode, tier])
  @@index([lookupTitle])
}

model PendingAdventureModule {
  id                    String   @id @default(cuid())
  adventureCode         String
  lookupCode            String
  title                 String
  lookupTitle           String
  tier                  Tier
  duration              String   @default("")
  gameSummary           String   @default("")
  adventureImagePath    String?
  serviceHours          Float    @default(0)
  downtimeDaysAwarded   Int      @default(0)
  gold                  String   @default("")
  spellbook             String   @default("")
  storyAwards           String   @default("")
  sourceSheet           String   @default("")
  sourceNotes           String   @default("")
  consumablesJson       String   @default("[]")
  commonMagicItemsJson  String   @default("[]")
  uncommonMagicItemsJson String  @default("[]")
  rareMagicItemsJson    String   @default("[]")
  veryRareMagicItemsJson String  @default("[]")
  legendaryMagicItemsJson String @default("[]")
  uniqueMagicItemsJson  String   @default("[]")
  boonsJson             String   @default("[]")
  blessingsJson         String   @default("[]")
  charmsJson            String   @default("[]")
  additionalMagicRewardNotes String @default("")
  additionalConsumableNotes String @default("")
  lastReportedByUserId  String?
  reportedDmName        String   @default("")
  reportedDatePlayed    DateTime?
  reportCount           Int      @default(1)
  lastReportedAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastReportedBy        User?    @relation("PendingAdventureModuleReportedBy", fields: [lastReportedByUserId], references: [id], onDelete: SetNull)

  @@unique([lookupCode, lookupTitle, tier])
  @@index([lookupCode, tier])
  @@index([adventureCode, tier])
  @@index([lookupTitle])
  @@index([lastReportedAt(sort: Desc)])
}

model Handbook {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpellbookMonthlySubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastSubscribedAt DateTime @default(now())
}

model GrimoireGuildMembershipSettings {
  id          String   @id
  productName String
  description String
  priceUsd    Float
  durationDays Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeagueLegalChoiceList {
  id        String   @id @default(cuid())
  category  String
  key       String
  label     String
  valuesJson String  @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, key])
  @@index([category, key])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  createdByUserId String?
  type            NotificationType @default(SYSTEM)
  title           String
  body            String
  detailsJson     String           @default("[]")
  actionLabel     String?
  actionHref      String?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("NotificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
}

model GrimoireEvent {
  id             String               @id
  label          String
  subtitle       String
  date           DateTime
  displayDate    String
  theme          String
  themeDetails   String               @default("[]")
  focus          String
  ticketLabel    String
  ticketPrice    String
  ticketPriceUsd Float
  finale         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  slots          GrimoireEventSlot[]
  curatedGames   GrimoireCuratedGame[]
  submissions    GrimoireDmSubmission[]

  @@index([date])
}

model GrimoireEventSlot {
  id        String        @id @default(cuid())
  eventId   String
  slotKey   String
  label     String
  startAt   DateTime
  endAt     DateTime
  gameSlotCount Int       @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     GrimoireEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slotKey])
  @@unique([eventId, startAt])
  @@index([eventId, startAt])
}

model GrimoireCuratedGame {
  id             String        @id @default(cuid())
  eventId        String
  slug           String        @unique
  title          String
  summary        String
  details        String        @default("[]")
  adventureImagePath String?
  startAt        DateTime
  dm             String
  tier           Tier
  ticketPrice    String
  ticketPriceUsd Float
  seatCapacity   Int
  gameCode       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  event          GrimoireEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startAt])
}

model GrimoireDmSubmission {
  id          String                     @id @default(cuid())
  name        String
  email       String
  discord     String?
  title       String
  gameCode    String?
  eventId     String
  slotStartAt DateTime
  tier        Tier
  seats       Int
  summary     String
  notes       String?
  status      GrimoireDmSubmissionStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  event       GrimoireEvent              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, slotStartAt])
}

model SiteMonitorEvent {
  id          String              @id @default(cuid())
  category    SiteMonitorCategory @default(SYSTEM_EVENT)
  level       SiteMonitorLevel    @default(INFO)
  source      String
  message     String
  detailsJson String              @default("[]")
  stack       String?
  requestPath String?
  createdAt   DateTime            @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([level, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
}

model SiteHealthCheck {
  id                String           @id @default(cuid())
  triggeredByUserId String?
  status            SiteHealthStatus
  summary           String
  reportJson        String
  durationMs        Int
  createdAt         DateTime         @default(now())
  triggeredBy       User?            @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model CheckoutOrder {
  id                String         @id @default(cuid())
  userId            String?
  provider          String         @default("PAYPAL")
  checkoutType      CheckoutType
  status            CheckoutStatus @default(CREATED)
  paypalOrderId     String         @unique
  receiptNumber     String?        @unique
  currencyCode      String         @default("USD")
  amountUsd         Float
  subtotalUsd       Float          @default(0)
  taxUsd            Float          @default(0)
  storeCreditAppliedUsd Float      @default(0)
  summaryText       String
  itemDataJson      String         @default("[]")
  recipientDataJson String         @default("[]")
  payerEmail        String?
  captureDataJson   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  capturedAt        DateTime?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  patronMembership  PatronMembership?
  ticketRefunds     TicketRefund[]

  @@index([status, createdAt(sort: Desc)])
  @@index([checkoutType, createdAt(sort: Desc)])
}

model TicketSalesSettings {
  id                      String   @id @default("default")
  provincialTaxRatePct    Float    @default(0)
  federalTaxRatePct       Float    @default(5)
  leagueGameDmPayoutRatePct Float  @default(0)
  eventGameDmPayoutRatePct Float   @default(0)
  updatedByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  updatedBy               User?    @relation("TicketSalesSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

model TicketRefund {
  id             String               @id @default(cuid())
  checkoutOrderId String?
  receiptNumber  String?              @unique
  checkoutType   CheckoutType
  saleSourceType TicketSaleSourceType @default(OTHER)
  saleSourceId   String?
  saleSourceLabel String
  amountUsd      Float
  creditGiven    Boolean              @default(false)
  creditAmountUsd Float               @default(0)
  currencyCode   String               @default("USD")
  reason         String
  notes          String?
  refundedAt     DateTime             @default(now())
  createdByUserId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  checkoutOrder  CheckoutOrder?       @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("TicketRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([checkoutType, refundedAt(sort: Desc)])
  @@index([saleSourceType, refundedAt(sort: Desc)])
}

model SpellbookExpenseReceipt {
  id              String   @id @default(cuid())
  expenseDate     DateTime
  cardHolder      String
  company         String
  serviceItem     String
  totalUsd        Float
  taxPaidUsd      Float
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User?    @relation("SpellbookExpenseReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([expenseDate(sort: Desc)])
  @@index([company])
}

model DmPaymentProfile {
  id                 String               @id @default(cuid())
  lookupKey          String               @unique
  dmUserId           String?              @unique
  dmName             String
  contactEmail       String?
  paymentMethodType  DmPaymentMethodType?
  paymentMethodLabel String?
  paymentDetails     String?
  notes              String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  dmUser             User?                @relation("DmPaymentProfileUser", fields: [dmUserId], references: [id], onDelete: SetNull)
  ticketPayouts      TicketPayout[]

  @@index([dmName])
}

model TicketPayout {
  id                 String             @id @default(cuid())
  groupKey           String?
  dmPaymentProfileId String?
  dmUserId           String?
  dmName             String
  checkoutType       CheckoutType
  saleSourceType     TicketSaleSourceType
  saleSourceId       String?
  saleSourceLabel    String
  seatCount          Int                @default(0)
  grossTicketSalesUsd Float
  payoutRatePct      Float
  payoutAmountUsd    Float
  paidPayoutRatePct  Float?
  currencyCode       String             @default("USD")
  status             TicketPayoutStatus @default(PENDING)
  notes              String?
  paidAt             DateTime?
  createdByUserId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  dmPaymentProfile   DmPaymentProfile?  @relation(fields: [dmPaymentProfileId], references: [id], onDelete: SetNull)
  dmUser             User?              @relation("TicketPayoutDmUser", fields: [dmUserId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation("TicketPayoutCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([groupKey])
  @@index([checkoutType, createdAt(sort: Desc)])
  @@index([saleSourceType, saleSourceId])
}

model PatronMembership {
  id              String         @id @default(cuid())
  userId          String
  checkoutOrderId String?        @unique
  source          String         @default("LEAGUE_CART")
  productName     String         @default("Grimoire Guild membership")
  startedAt       DateTime
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutOrder   CheckoutOrder? @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt, expiresAt])
  @@index([expiresAt])
}
